<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Replace __YTDIGEST_HOME__ with the absolute path to your checkout,
  then install:

    sed "s|__YTDIGEST_HOME__|$PWD|g" ops/com.ytdigest.plist.template \
      > ~/Library/LaunchAgents/com.ytdigest.plist
    launchctl load ~/Library/LaunchAgents/com.ytdigest.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ytdigest</string>

  <!-- caffeinate -i keeps the machine awake through a long transcription.
       yt-dlp is upgraded first: a stale copy is the single most likely cause
       of a silent pipeline stall when YouTube changes something. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd __YTDIGEST_HOME__ &amp;&amp; ./.venv/bin/python -m pip install -q -U yt-dlp ; /usr/bin/caffeinate -i ./.venv/bin/ytdigest run</string>
  </array>

  <!-- launchd, not cron: cron silently skips runs when the Mac sleeps. -->
  <!-- Times are HKT (the machine's local zone) and are chosen to sit in
       DeepSeek's off-peak window, where tokens are half the peak price.
       Peak is 09:00-12:00 and 14:00-18:00 HKT (01:00-04:00 and 06:00-10:00 UTC).

       22:30 is the main run: the last evening show ends about 20:20, so
       captions have had two hours to appear, and everything from the trading
       day is already long finished.
       06:30 is the catch-up: anything whose captions landed overnight,
       especially the 2.5-hour morning programme, gets picked up here. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>WorkingDirectory</key>
  <string>__YTDIGEST_HOME__</string>
  <key>StandardOutPath</key>
  <string>__YTDIGEST_HOME__/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__YTDIGEST_HOME__/data/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <!-- Keeps this behind interactive work on a memory-constrained machine. -->
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
