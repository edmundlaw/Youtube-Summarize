# Copy to .env and fill in. Never commit .env — it is gitignored.
#   cp .env.example .env && chmod 600 .env

# Summariser. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Telegram delivery (optional; set publish.telegram=false in config to skip).
# Create a bot via @BotFather, then run:  ytdigest telegram-setup --token <token>
# That command discovers and writes CHAT_ID for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for forum-style supergroups with topics.
TELEGRAM_MESSAGE_THREAD_ID=
